{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SANA License Manager",
  "version": "1.0.0",
  "identifier": "com.sana.licensemanager",
  "build": {
    "frontendDist": ["../index.html", "../manager.js"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SANA License Manager",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https:; connect-src ipc: http://ipc.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
